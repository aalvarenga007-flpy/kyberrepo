# Plantilla de configuracion. Copiar a .env y completar.
# El .env NUNCA se versiona.
#
# Las 24 claves que lee core/config.py.
# Ojo: el .env.example viejo del proyecto estaba incompleto — le faltaban las
# cuatro AUTH_* y CLIENTE_ID, y sin ellas el login rechaza a todos sin decir
# por que. Esta plantilla las incluye.

APP_NAME=Conepasa IA
APP_ENV=local

# --- MySQL: motor -----------------------------------------------------------
# Para desarrollo contra la base del servidor, abrir primero un tunel SSH:
#   ssh -i ~/.ssh/kyber_ed25519 -p 715 -L 3306:127.0.0.1:3306 root@186.12.177.53
# y dejar esa ventana abierta. Entonces 127.0.0.1:3306 es la base del servidor.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=conepasa_readonly
MYSQL_PASSWORD=
EKARU_DATABASE=ekaru_gastronomia_bi
EJAPO_DATABASE=ejapo_sanjose_bi
SQL_MAX_ROWS=500

# --- MySQL: autenticacion ---------------------------------------------------
# En desarrollo conviene apuntar a conepasa_auth_pruebas para no ensuciar
# los logins ni el consumo de produccion.
AUTH_DATABASE=conepasa_auth_pruebas
AUTH_MYSQL_USER=conepasa_auth
AUTH_MYSQL_PASSWORD=
AUTH_SESSION_HORAS=12
CLIENTE_ID=ekaru

# --- Agente -----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_SIMPLE=claude-haiku-4-5-20251001
ROUTING_MODO=activo
MAX_TOOL_ROUNDS=14

# --- Correo -----------------------------------------------------------------
# En desarrollo dejar ALERT_SEND_EMAIL=false para no mandar correos reales.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_SEND_EMAIL=false

# En Windows abre una ventana del navegador. En un servidor sin pantalla falla.
ALERT_SHOW_WINDOW=false

# --- Modulos ----------------------------------------------------------------
MODULO_PRESUPUESTOS=true
