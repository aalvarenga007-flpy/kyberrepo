# /etc/kyber/kyber.env — permisos 600, dueno el usuario de servicio 'kyber'.
# NUNCA se versiona. NUNCA va en una carpeta sincronizada a la nube.
#
# Las 24 claves que lee core/config.py, relevadas del sistema en ejecucion.
# Los valores se completan a mano DESPUES de la rotacion de la Fase S5.

APP_NAME=Conepasa IA
APP_ENV=produccion

# --- MySQL: motor -----------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# En Windows esto es 'root'. En Rocky se crea un usuario de privilegios minimos.
MYSQL_USER=conepasa_readonly
MYSQL_PASSWORD=
EKARU_DATABASE=ekaru_gastronomia_bi
EJAPO_DATABASE=ejapo_sanjose_bi
SQL_MAX_ROWS=500

# --- MySQL: autenticacion ---------------------------------------------------
AUTH_DATABASE=conepasa_auth
AUTH_MYSQL_USER=conepasa_auth
AUTH_MYSQL_PASSWORD=
AUTH_SESSION_HORAS=12

# Sin CLIENTE_ID ni las cuatro AUTH_* el login rechaza a todos, y el sintoma
# no dice por que. Es la trampa numero 8 del handoff.
CLIENTE_ID=ekaru

# --- Agente -----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_SIMPLE=claude-haiku-4-5-20251001
ROUTING_MODO=activo
MAX_TOOL_ROUNDS=14

# --- Correo -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_SEND_EMAIL=true

# En Windows abre una ventana del navegador. En un servidor sin pantalla falla.
ALERT_SHOW_WINDOW=false

# --- Modulos ----------------------------------------------------------------
MODULO_PRESUPUESTOS=true
